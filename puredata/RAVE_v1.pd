#N canvas 34 66 1219 824 12;
#X text 70 26 ========== RAVE_v1 ==========;
#X text 70 50 Maps eye/colour/velocity signals to RAVE latent dims via nn~., f 75;
#X text 70 70 z0=gaze X z1=gaze Y z2=hue z3=brightness z4=velocity (range -3..+3), f 80;
#X text 70 90 blink / flutter / intentional: 0|1 events;
#X obj 100 140 netreceive 9001;
#X text 250 140 <- TCP port 9001 (FUDI);
#X obj 100 190 route z0 z1 z2 z3 z4 blink flutter intentional;
#X obj 50 250 sig~ 0;
#X obj 130 250 sig~ 0;
#X obj 210 250 sig~ 0;
#X obj 290 250 sig~ 0;
#X obj 370 250 sig~ 0;
#X floatatom 490 250 4 0 1 1 - - - 0;
#X floatatom 560 250 4 0 1 1 - - - 0;
#X floatatom 630 250 4 0 1 1 - - - 0;
#X text 490 272 blink;
#X text 560 272 flutter;
#X text 630 272 intentional;
#X text 50 272 z0;
#X text 130 272 z1;
#X text 210 272 z2;
#X text 290 272 z3;
#X text 370 272 z4;
#X text 400 340 <- double-click to set path and inlet count;
#X text 400 360 check latent_control_channels in .nn_info.json;
#X obj 100 340 nn~ /path/to/model.ts;
#X obj 100 420 dac~;
#X text 70 470 --- BioPoint (OSC UDP 9000) ---;
#X text 70 490 z5=EMG envelope z6=accel X z7=accel Y z8=accel Z, f 90;
#X text 270 530 <- UDP port 9000 (OSC \, the 1 = UDP mode);
#X obj 100 560 oscparse;
#X obj 100 590 route /sifi/emg /sifi/imu/accel;
#X obj 50 640 unpack f;
#X obj 50 665 abs;
#X obj 50 690 * 3;
#X obj 50 715 sig~ 0;
#X text 50 737 z5;
#X text 50 757 adjust [* 3] to taste;
#X obj 260 640 unpack f f f;
#X obj 230 690 * 1.5;
#X obj 230 715 sig~ 0;
#X text 230 737 z6;
#X obj 310 690 * 1.5;
#X obj 310 715 sig~ 0;
#X text 310 737 z7;
#X obj 390 690 * 1.5;
#X obj 390 715 sig~ 0;
#X text 390 737 z8;
