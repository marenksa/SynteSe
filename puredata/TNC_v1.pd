#N canvas 0 32 1470 868 12;
#X text 20 10 ========== COLOR TO MUSIC ==========;
#X text 20 30 Fixation-based note triggering with ADSR envelope.;
#X text 20 50 Red (long wavelength) = C \, Violet (short) = B;
#X text 20 70 Brightness determines octave (darker = lower);
#X text 20 110 === STEP 1: RECEIVING ===;
#X obj 50 140 netreceive 9001;
#X text 175 140 <- TCP port 9001 (FUDI format);
#X text 20 272 === STEP 2: NOTE PROCESSING ===;
#X floatatom 50 312 5 0 127 0 MIDI - - 0;
#X text 94 311 <- MIDI note (36-83);
#X obj 50 352 mtof;
#X text 94 352 <- MIDI to frequency (Hz);
#X floatatom 50 392 8 0 0 0 Hz - - 0;
#X text 118 394 <- Current frequency;
#X text 20 442 === STEP 3: SOUND SYNTHESIS ===;
#X obj 50 472 osc~;
#X text 93 470 <- Sine wave oscillator;
#X obj 50 536 *~;
#X text 83 535 <- Volume (controlled by envelope);
#X text 111 903 <- Audio output (turn on DSP!);
#X text 822 108 === CONTROLS ===;
#X text 824 273 === ENVELOPE (ADSR) ===;
#X text 824 298 Attack: 20ms (quick onset);
#X text 824 318 Decay: 80ms;
#X text 824 338 Sustain: 75%;
#X text 824 393 === COLOR LEGEND ===;
#X text 824 418 C = Red (700nm);
#X text 824 438 D = Orange (620nm);
#X text 824 458 E = Yellow (580nm);
#X text 824 478 F = Green (530nm);
#X text 824 498 G = Cyan (500nm);
#X text 824 518 A = Blue (470nm);
#X text 824 538 B = Violet (400nm);
#X text 824 593 Octave 4 = Medium;
#X text 824 613 Octave 6 = Very bright;
#X text 824 241 Run Python with: --pd;
#X obj 825 168 output~;
#X obj 50 902 s~ out;
#X obj 825 139 r~ out;
#X obj 307 500 vline~;
#X obj 308 311 bng 19 250 50 0 empty empty empty 0 -10 0 12 #fcfcfc #000000 #000000;
#X obj 50 217 t b f;
#X text 343 311 <- Trigger ADSR;
#X text 824 358 Release: 200ms;
#X text 153 681 <- Reverb Volume: 100 Liveliness: 60;
#X obj 50 627 AM-midi;
#X text 284 181 <- Parse note_on or AM messages;
#X floatatom 121 590 5 0 0 0 - - - 0;
#X text 165 589 <- MIDI: 0 - 50;
#X obj 291 589 hsl 162 19 0 50 0 0 am-lfo am-lfo LFO -2 -10 0 12 #c6ffc7 #000000 #000000 0 1;
#X msg 307 469 1 20 \, 0.75 80 20 \, 0 300 100;
#X text 824 573 Octave 3 = Dark;
#X obj 125 760 noise~;
#X obj 134 801 *~;
#X obj 195 760 hsl 162 19 0 1 0 0 empty empty empty -2 -10 0 12 #ffc7c6 #000000 #000000 0 1;
#X obj 50 180 route note_on am_lfo confidence;
#X obj 192 728 expr 1 - $f1;
#X obj 50 682 rev2~ 100 75;
#X text 686 998 _;
#X obj 134 850 *~;
#X obj 195 829 hsl 162 19 0 1 0 0 empty empty empty -2 -10 0 12 #ffc7c6 #000000 #000000 0 1;
