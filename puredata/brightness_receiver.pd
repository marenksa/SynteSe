#N canvas 100 100 900 700 12;

#X text 20 10 ========== BRIGHTNESS RECEIVER ==========;
#X text 20 30 Receives brightness data from Python via OSC;
#X text 20 50 Port: 9000 \, Address: /brightness (0-1 range);

#N canvas 0 0 450 300 mrpeach-check 0;
#X text 20 20 If you see errors about oscparse/routeOSC:;
#X text 20 50 1. Go to Help -> Find externals;
#X text 20 70 2. Search for "mrpeach";
#X text 20 90 3. Install it;
#X text 20 110 4. Restart Pd and reopen this patch;
#X restore 650 10 pd mrpeach-check;

#X obj 50 100 netreceive -u -b 9000;
#X text 220 100 <- Listen on UDP port 9000;

#X obj 50 140 oscparse;
#X text 220 140 <- Parse OSC messages;

#X obj 50 180 routeOSC /brightness;
#X text 220 180 <- Route /brightness messages;

#X obj 50 220 unpack f;
#X text 220 220 <- Extract float value;

#X obj 50 260 t f f;
#X text 220 260 <- Trigger: send to display AND audio;

#X floatatom 150 300 8 0 1 0 - - - 0;
#X text 230 300 <- Current brightness (0-1);

#X obj 50 340 pack f 150;
#X text 220 340 <- Pack with ramp time (150ms = smoothing);

#X obj 50 380 line;
#X text 220 380 <- Interpolate smoothly between values;

#X obj 50 420 t f f;

#X floatatom 150 460 8 0 1 0 - - - 0;
#X text 230 460 <- Smoothed brightness;

#N canvas 0 0 600 500 SOUND-ENGINE 0;
#X obj 50 50 inlet;
#X text 120 50 <- smoothed brightness 0-1;

#X text 50 90 === BRIGHTNESS TO PITCH ===;
#X obj 50 120 * 600;
#X obj 50 150 + 150;
#X text 150 150 <- Frequency: 150-750 Hz;

#X obj 50 190 pack f 20;
#X obj 50 220 line~;
#X text 150 220 <- Audio-rate interpolation;

#X obj 50 260 osc~;
#X text 150 260 <- Sine oscillator;

#X obj 50 300 *~ 0.3;
#X text 150 300 <- Volume;

#X obj 50 340 dac~;
#X text 150 340 <- Audio output (turn on DSP!);

#X connect 0 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 6 0;
#X connect 6 0 7 0;
#X connect 7 0 9 0;
#X connect 9 0 11 0;
#X connect 11 0 13 0;
#X connect 11 0 13 1;
#X restore 50 500 pd SOUND-ENGINE;

#X text 180 500 <- Click to open sound engine;

#X text 20 560 ========== CONTROLS ==========;

#X obj 50 590 tgl 25 0 empty empty DSP 30 10 0 10 #ffffff #000000 #000000 0 1;
#X obj 90 590 dsp;
#X text 130 590 <- Toggle DSP on/off;

#X obj 250 590 hradio 20 1 0 5 empty empty Smoothing 0 -10 0 10 #ffffff #000000 #000000 2;
#X obj 250 620 * 50;
#X obj 250 650 + 50;
#X msg 250 680 pack f \$1;
#X text 350 590 <- Adjust smoothing (50-250ms);

#X connect 4 0 6 0;
#X connect 6 0 8 0;
#X connect 8 0 10 0;
#X connect 10 0 12 0;
#X connect 12 0 13 0;
#X connect 12 1 14 0;
#X connect 15 0 17 0;
#X connect 17 0 19 0;
#X connect 19 0 20 0;
#X connect 19 1 21 0;
#X connect 21 0 23 0;
#X connect 26 0 27 0;
#X connect 29 0 30 0;
#X connect 30 0 31 0;
#X connect 31 0 32 0;

