#N canvas 100 100 800 600 12;
#X text 20 10 ========== BRIGHTNESS RECEIVER (SIMPLE) ==========;
#X text 20 30 No externals needed! Uses FUDI protocol over TCP.;
#X text 20 50 Run Python with: --pd-fudi flag;
#X text 20 90 === STEP 1: RECEIVING ===;
#X obj 50 120 netreceive 9001;
#X text 200 120 <- TCP port 9001 (FUDI format);
#X obj 50 160 route brightness;
#X text 200 160 <- Filter "brightness" messages;
#X obj 50 200 t f f;
#X text 200 200 <- Send to display AND processing;
#X floatatom 150 240 8 0 1 0 brightness - - 0;
#X text 230 240 <- Raw brightness (0-1);
#X text 20 280 === STEP 2: SMOOTHING ===;
#X obj 50 310 pack f 150;
#X text 200 310 <- Ramp time: 150ms (adjust for inertia);
#X obj 50 350 line;
#X text 200 350 <- Smooth interpolation;
#X obj 50 390 t f f;
#X floatatom 150 430 8 0 1 0 smoothed - - 0;
#X text 230 430 <- Smoothed brightness;
#X text 20 470 === STEP 3: SOUND ===;
#X obj 50 500 * 600;
#X obj 50 530 + 150;
#X text 200 530 <- Frequency: 150-750 Hz;
#X obj 50 560 osc~;
#X obj 50 590 *~ 0.25;
#X text 200 590 <- Volume;
#X obj 50 620 dac~;
#X text 200 620 <- TURN ON DSP! (Media menu or checkbox below);
#X text 500 90 === CONTROLS ===;
#X obj 500 120 tgl 25 0 empty empty DSP 30 10 0 10 #fcfcfc #000000 #000000 0 1;
#X obj 540 120 dsp;
#X text 500 160 Smoothing (ms):;
#X obj 500 190 hradio 15 1 0 8 empty empty empty 0 -8 0 10 #fcfcfc #000000 #000000 0;
#X obj 500 220 * 50;
#X obj 500 250 + 50;
#X text 630 250 <- 50-400ms;
#X connect 4 0 6 0;
#X connect 6 0 8 0;
#X connect 8 0 10 0;
#X connect 8 1 13 0;
#X connect 13 0 15 0;
#X connect 15 0 17 0;
#X connect 17 0 18 0;
#X connect 17 1 21 0;
#X connect 21 0 22 0;
#X connect 22 0 24 0;
#X connect 24 0 25 0;
#X connect 25 0 27 0;
#X connect 33 0 34 0;
#X connect 34 0 13 1;
