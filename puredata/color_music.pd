#N canvas 0 32 1470 868 12;
#X text 20 10 ========== COLOR TO MUSIC ==========;
#X text 20 30 Fixation-based note triggering with ADSR envelope.;
#X text 20 50 Red (long wavelength) = C \, Violet (short) = B;
#X text 20 70 Brightness determines octave (darker = lower);
#X text 20 110 === STEP 1: RECEIVING ===;
#X obj 50 140 netreceive 9001;
#X text 175 140 <- TCP port 9001 (FUDI format);
#X text 20 250 === STEP 2: NOTE PROCESSING ===;
#X floatatom 50 290 5 0 127 0 MIDI - - 0;
#X text 94 289 <- MIDI note (36-83);
#X obj 50 330 mtof;
#X text 94 330 <- MIDI to frequency (Hz);
#X floatatom 50 370 8 0 0 0 Hz - - 0;
#X text 118 372 <- Current frequency;
#X text 20 420 === STEP 3: SOUND SYNTHESIS ===;
#X obj 50 450 osc~;
#X text 93 448 <- Sine wave oscillator;
#X obj 50 514 *~;
#X text 83 513 <- Volume (controlled by envelope);
#X text 111 711 <- Audio output (turn on DSP!);
#X text 822 108 === CONTROLS ===;
#X text 824 273 === ENVELOPE (ADSR) ===;
#X text 824 298 Attack: 20ms (quick onset);
#X text 824 318 Decay: 80ms;
#X text 824 338 Sustain: 75%;
#X text 824 393 === COLOR LEGEND ===;
#X text 824 418 C = Red (700nm);
#X text 824 438 D = Orange (620nm);
#X text 824 458 E = Yellow (580nm);
#X text 824 478 F = Green (530nm);
#X text 824 498 G = Cyan (500nm);
#X text 824 518 A = Blue (470nm);
#X text 824 538 B = Violet (400nm);
#X text 824 573 Octave 2 = Very dark;
#X text 824 593 Octave 4 = Medium;
#X text 824 613 Octave 6 = Very bright;
#X text 824 241 Run Python with: --pd;
#X obj 825 168 output~;
#X obj 50 710 s~ out;
#X obj 825 139 r~ out;
#X obj 307 478 vline~;
#X obj 308 289 bng 19 250 50 0 empty empty empty 0 -10 0 12 #fcfcfc #000000 #000000;
#X obj 50 217 t b f;
#X text 343 289 <- Trigger ADSR;
#X obj 50 660 rev2~ 100 60;
#X text 824 358 Release: 200ms;
#X text 153 659 <- Reverb Volume: 100 Liveliness: 60;
#X obj 50 605 AM-midi;
#X text 194 181 <- Parse note_on or AM messages;
#X obj 50 180 route note_on am_lfo;
#X floatatom 114 568 5 0 0 0 - - - 0;
#X text 158 567 <- MIDI: 0 - 50;
#X obj 284 567 hsl 162 19 0 50 0 0 am-lfo am-lfo LFO -2 -10 0 12 #c6ffc7 #000000 #000000 0 1;
#X msg 307 447 1 20 \, 0.75 80 20 \, 0 300 100;
#X connect 5 0 49 0;
#X connect 8 0 10 0;
#X connect 10 0 12 0;
#X connect 10 0 15 0;
#X connect 15 0 17 0;
#X connect 17 0 47 0;
#X connect 39 0 37 0;
#X connect 40 0 17 1;
#X connect 41 0 53 0;
#X connect 42 0 41 0;
#X connect 42 1 8 0;
#X connect 44 0 38 0;
#X connect 47 0 44 0;
#X connect 49 0 42 0;
#X connect 49 1 50 0;
#X connect 50 0 47 1;
#X connect 53 0 40 0;
