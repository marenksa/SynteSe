#N canvas 100 100 900 700 12;
#X text 20 10 ========== COLOR TO MUSIC ==========;
#X text 20 30 Maps colors to musical notes based on wavelength.;
#X text 20 50 Red (long wavelength) = C, Violet (short) = B;
#X text 20 70 Brightness determines octave (darker = lower);
#X text 20 110 === STEP 1: RECEIVING ===;
#X obj 50 140 netreceive 9001;
#X text 230 140 <- TCP port 9001 (FUDI format);
#X obj 50 180 route midinote note octave brightness;
#X text 400 180 <- Parse incoming messages;
#X text 20 220 === STEP 2: MIDI NOTE PROCESSING ===;
#X obj 50 250 t f f;
#X floatatom 150 290 5 0 127 0 MIDI - - 0;
#X text 200 290 <- MIDI note (36-83);
#X obj 50 330 pack f 100;
#X text 200 330 <- 100ms interpolation;
#X obj 50 370 line;
#X text 200 370 <- Smooth note changes;
#X obj 50 410 mtof;
#X text 200 410 <- MIDI to frequency (Hz);
#X floatatom 150 450 8 0 0 0 Hz - - 0;
#X text 230 450 <- Current frequency;
#X text 20 490 === STEP 3: SOUND SYNTHESIS ===;
#X obj 50 520 osc~;
#X text 200 520 <- Sine wave oscillator;
#X obj 50 560 *~ 0.25;
#X text 200 560 <- Volume (0.25);
#X obj 50 600 dac~;
#X text 200 600 <- Audio output (turn on DSP!);
#X text 550 110 === CONTROLS ===;
#X obj 550 140 tgl 25 0 empty empty DSP 30 10 0 10 #fcfcfc #000000 #000000 0 1;
#X obj 590 140 dsp;
#X text 550 180 === INFO DISPLAY ===;
#X obj 300 250 t f f;
#X floatatom 400 290 3 0 6 0 Note - - 0;
#X text 440 290 <- 0=C 1=D 2=E 3=F 4=G 5=A 6=B;
#X obj 300 330 t f f;
#X floatatom 400 370 3 2 6 0 Octave - - 0;
#X text 440 370 <- Octave (2-6);
#X obj 300 410 t f f;
#X floatatom 400 450 6 0 1 0 Bright - - 0;
#X text 470 450 <- Brightness (0-1);
#X text 550 220 === COLOR LEGEND ===;
#X text 550 245 C = Red (700nm);
#X text 550 265 D = Orange (620nm);
#X text 550 285 E = Yellow (580nm);
#X text 550 305 F = Green (530nm);
#X text 550 325 G = Cyan (500nm);
#X text 550 345 A = Blue (470nm);
#X text 550 365 B = Violet (400nm);
#X text 550 400 Octave 2 = Very dark;
#X text 550 420 Octave 4 = Medium;
#X text 550 440 Octave 6 = Very bright;
#X text 20 640 Run Python with: --pd-color-fudi;
#X connect 5 0 7 0;
#X connect 7 0 10 0;
#X connect 7 1 32 0;
#X connect 7 2 35 0;
#X connect 7 3 38 0;
#X connect 10 0 11 0;
#X connect 10 1 13 0;
#X connect 13 0 15 0;
#X connect 15 0 17 0;
#X connect 17 0 19 0;
#X connect 17 0 22 0;
#X connect 22 0 24 0;
#X connect 24 0 26 0;
#X connect 29 0 30 0;
#X connect 32 0 33 0;
#X connect 35 0 36 0;
#X connect 38 0 39 0;
